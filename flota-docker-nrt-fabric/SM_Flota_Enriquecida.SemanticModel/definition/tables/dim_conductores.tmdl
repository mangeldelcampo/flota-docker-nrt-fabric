table dim_conductores
	lineageTag: c7c11119-0e23-4dde-b34f-2f9bcd74b60b
	sourceLineageTag: [dbo].[dim_conductores]

	measure 1_Saldo_Puntos_Actual =
			
			VAR PuntosIniciales = MAX('dim_conductores'[Saldo_Puntos_Inicial])
			VAR PuntosPerdidos = SUM('fact_multas'[Puntos_DGT_Retirados])
			RETURN
			PuntosIniciales - COALESCE(PuntosPerdidos, 0)
		formatString: 0
		lineageTag: a1989849-bd67-49ff-8cd9-32b557d766f1

		changedProperty = Name

	measure 2_Alerta_Operativa_RRHH =
			
			VAR Saldo = [1_Saldo_Puntos_Actual]
			VAR Medico_Apto = SELECTEDVALUE('dim_conductores'[Apto_Medico])
			VAR Permiso = UPPER(TRIM(SELECTEDVALUE('dim_conductores'[Estado_Permiso])))
			
			RETURN
			SWITCH(
			    TRUE(),
			    Medico_Apto = FALSE(), "🔴 SUSPENSIÓN: No Apto Médico",
			    CONTAINSSTRING(Permiso, "CADUC"), "🔴 SUSPENSIÓN: Permiso Caducado",
			    ISBLANK(Saldo), "Sin Datos",
			    Saldo >= 8, "🟢 OK (Operativo)",
			    Saldo >= 4, "🟡 AVISO: Curso Recuperación Parcial",
			    Saldo >= 1, "🟠 CRÍTICO: Pre-reemplazo",
			    "🔴 SUSPENSIÓN: Retirada de Licencia por Puntos"
			)
		lineageTag: a37a2354-ac47-412a-9542-794339998c90

		changedProperty = Name

	measure 3_Color_Alerta_RRHH =
			
			VAR Medico_Apto = SELECTEDVALUE('dim_conductores'[Apto_Medico])
			VAR Permiso = UPPER(TRIM(SELECTEDVALUE('dim_conductores'[Estado_Permiso])))
			VAR Saldo = [1_Saldo_Puntos_Actual]
			
			RETURN
			SWITCH(
			    TRUE(),
			    Medico_Apto = FALSE(), "#FAD2CF",               -- Rojo intenso
			    CONTAINSSTRING(Permiso, "CADUC"), "#FAD2CF",     -- Rojo intenso
			    ISBLANK(Saldo), "#FFFFFF",
			    Saldo >= 8, "#E6F4EA",                          -- Verde claro
			    Saldo >= 4, "#FEF7E0",                          -- Amarillo claro
			    Saldo >= 1, "#FCE8E6",                          -- Naranja claro
			    "#FAD2CF"                                       -- Rojo intenso (0 puntos)
			)
		lineageTag: baeec42b-ecae-4cd9-810f-5b19930b6680

		changedProperty = Name

	measure Alertas_Carnet = ```
			
			VAR Conteo = 
			    CALCULATE(
			        COUNTROWS('dim_conductores'),
			        SEARCH("CADUC", UPPER('dim_conductores'[Estado_Permiso]), 1, 0) > 0
			    )
			RETURN
			COALESCE(Conteo, 0)
			```
		formatString: 0
		lineageTag: c45b1c7c-c209-451c-84d3-91c91b62644e

		changedProperty = Name

	measure Conductores_Suspendidos = ```
			
			COUNTROWS(
			    FILTER(
			        'dim_conductores',
			        [1_Saldo_Puntos_Actual] <= 0 || 
			        SEARCH("CADUC", UPPER('dim_conductores'[Estado_Permiso]), 1, 0) > 0 || 
			        'dim_conductores'[Apto_Medico] = FALSE
			    )
			)
			```
		formatString: 0
		lineageTag: b7b904ef-7c45-467f-86bd-e5a116dce570

		changedProperty = Name

	measure No_Aptos_Medicos = ```
			
			COALESCE(
			    CALCULATE(
			        COUNTROWS('dim_conductores'), 
			        'dim_conductores'[Apto_Medico] = FALSE
			    ),
			    0
			)
			```
		formatString: 0
		lineageTag: 1d49c951-9813-4c0b-bb1e-d4dba5335bdf

		changedProperty = Name

