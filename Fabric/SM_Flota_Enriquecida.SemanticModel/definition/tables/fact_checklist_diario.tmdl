table fact_checklist_diario
	lineageTag: 208f78b2-9e4f-4b14-a870-c46894c6a669
	sourceLineageTag: [dbo].[fact_checklist_diario]

	measure Checklists_Con_Danos =
			
			COALESCE(
			    CALCULATE(
			        COUNTROWS('fact_checklist_diario'),
			        'fact_checklist_diario'[Estado_Visual] IN {"Con Daños", "Con Daños Previos"}
			    ),
			    0
			)
		formatString: 0
		lineageTag: e0d12189-8fb2-4a9c-acdf-5bd71d41f49c

		changedProperty = Name

	measure Tasa_Incidentes_PreRuta =
			
			VAR TotalChecklists = COUNTROWS('fact_checklist_diario')
			RETURN
			DIVIDE([Checklists_Con_Danos], TotalChecklists, 0)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 2ac958c0-683e-4190-8110-9854b0a016d2

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isCustom":true}

