table telemetria_enriquecida
	lineageTag: 8fccbe0b-1b2a-4451-8d9c-e5bba750b2d4
	sourceLineageTag: [dbo].[telemetria_enriquecida]

	measure 'Vehiculos activos' =
			
			COALESCE(
			    DISTINCTCOUNT('telemetria_enriquecida'[VehicleID]),
			    0
			)
		formatString: 0
		lineageTag: a673eccf-a327-46c4-b67b-655c36e6787c

		changedProperty = Name

	measure Velocidad_Media_Flota =
			
			ROUND(
			    COALESCE(
			        AVERAGE('telemetria_enriquecida'[Speed]),
			        0
			    ),
			    1
			)
		lineageTag: bf21f6d0-c8fc-43da-af6a-d1043ba9d28c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Vehiculos_Combustible_Critico_Global =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT('telemetria_enriquecida'[VehicleID]),
			        'telemetria_enriquecida'[FuelLevel] < 15,
			        ALL('telemetria_enriquecida'[VehicleID]),
			        ALL('dim_vehiculos_tecnica'[VehicleID])
			    ),
			    0
			)
		formatString: 0
		lineageTag: 7c68f655-bebb-4c2b-ac9e-797fe1c3fc52

		changedProperty = Name

	measure Es_Ultima_Posicion_En_Contexto = ```
			
			VAR MaxEventoVehiculoContexto = 
			    CALCULATE(
			        MAX('telemetria_enriquecida'[Hora_Evento]),
			        ALLEXCEPT(
			            'telemetria_enriquecida', 
			            'telemetria_enriquecida'[VehicleID],
			            'dim_calendario'[Fecha], 
			            'dim_hora'[Hora] 
			        )
			    )
			RETURN 
			    IF(
			        SELECTEDVALUE('telemetria_enriquecida'[Hora_Evento]) = MaxEventoVehiculoContexto,
			        1,
			        0
			    )
			```
		formatString: 0
		lineageTag: 6d282833-dd2b-406a-a141-7b066aa08e78

		changedProperty = Name

	measure Titulo_Cabecera_Operaciones =
			
			"Torre de Control de Flota | Fecha: " & [Fechas_Seleccionadas] & " | Horas: " & [Horas_Seleccionadas]
		lineageTag: 441523b4-f89e-43b5-a711-f0e3ba602b97

		changedProperty = Name

	measure Lista_Vehiculos_Criticos = ```
			
			VAR VehiculosBajoNivel = 
			    CALCULATETABLE(
			        VALUES('telemetria_enriquecida'[VehicleID]),
			        'telemetria_enriquecida'[FuelLevel] < 15
			    )
			VAR Conteo = COUNTROWS(VehiculosBajoNivel)
			RETURN
			SWITCH(
			    TRUE(),
			    Conteo = 0, "🟢 Flota OK (Sin unidades en reserva)",
			    CONCATENATEX(VehiculosBajoNivel, 'telemetria_enriquecida'[VehicleID], ", ")
			)
			```
		lineageTag: 6ede0e2e-3c00-4b39-a90d-e475b83d9598

		changedProperty = Name

	measure Filtro_Alerta_Combustible =
			
			IF(
			    CALCULATE(
			        MAX('telemetria_enriquecida'[FuelLevel]),
			        ALL('dim_vehiculos_tecnica'[VehicleID]),
			        ALL('telemetria_enriquecida'[VehicleID])
			    ) < 15,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 94a331c3-f035-45b7-b17e-606bdbbf69ee

		changedProperty = Name

	measure Nivel_Combustible_Actual =
			
			VAR MaxEventoEnContexto = MAX('telemetria_enriquecida'[Hora_Evento])
			RETURN
			CALCULATE(
			    MAX('telemetria_enriquecida'[FuelLevel]),
			    'telemetria_enriquecida'[Hora_Evento] = MaxEventoEnContexto
			)
		lineageTag: 1b06433f-49cc-428d-a688-44436ee2c9a0

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

